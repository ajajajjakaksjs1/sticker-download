{
  "name": "sticker-download-bot",
  "version": "1.0.0",
  "description": "Telegram bot for downloading and converting stickers",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "watch": "nodemon --exec ts-node src/main.ts"
  },
  "keywords": ["telegram", "bot", "stickers", "download", "convert"],
  "author": "openhands",
  "license": "MIT",
  "dependencies": {
    "telegraf": "^4.15.6",
    "axios": "^1.6.2",
    "sharp": "^0.33.0",
    "archiver": "^6.0.1",
    "fs-extra": "^11.2.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/fs-extra": "^11.0.4",
    "@types/archiver": "^6.0.2",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.2"
  }
}